# Browser-safe Pollar key. Confirm the final name in the dashboard before Phase 1.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=

# Server-only Pollar secret. Never expose through a NEXT_PUBLIC_ variable.
POLLAR_SECRET_KEY=

# Browser-safe Supabase project values. Supabase is not connected in Phase 0.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only privileged key. Never import into Client Components.
SUPABASE_SECRET_KEY=
