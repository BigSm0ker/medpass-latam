# Browser-safe Pollar key. It must belong to the SAME network that
# MEDPASS_STELLAR_NETWORK pins in src/lib/pollar/config.ts — the TestNet and
# Mainnet applications are separate and their keys are not interchangeable.
# Being NEXT_PUBLIC_, it is inlined at build time: changing it without a rebuild
# changes nothing.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=

# Server-only Pollar secret. Never expose through a NEXT_PUBLIC_ variable.
POLLAR_SECRET_KEY=

# Browser-safe Supabase project values. Supabase is not connected in Phase 0.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only privileged key. Never import into Client Components.
SUPABASE_SECRET_KEY=

# Signs the server session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
